[Unit]
Description=cgateweb - C-Bus to MQTT Bridge
Documentation=https://github.com/dougrathbone/cgateweb
Wants=cgate.service network-online.target
After=network-online.target cgate.service

[Service]
# %I is the install directory and %NODE% the node binary; the installer
# substitutes both. node is NOT hardcoded to /usr/bin/node because anyone who
# installed a supported Node via nvm, fnm or asdf has it elsewhere - the
# installer's version check passes on the interpreter running it, and the unit
# would then fail 203/EXEC on a path that does not exist.
Type=simple
ExecStart=%NODE% %I/index.js
ExecReload=/bin/kill -USR1 $MAINPID
Restart=always
RestartSec=10
User=cgateweb
Group=cgateweb
Environment=PATH=/usr/bin:/usr/local/bin
Environment=NODE_ENV=production
WorkingDirectory=%I
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cgateweb

# Graceful shutdown
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
# %PROTECT_HOME% is yes unless the install directory is under /home, where
# ProtectHome=yes makes WorkingDirectory unreachable and the unit fails
# 200/CHDIR. The installer picks the value and warns when it has to relax it.
ProtectHome=%PROTECT_HOME%
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=%I
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
