#!/usr/bin/with-contenv bashio
# ==============================================================================
# Run C-Gate server (managed mode only)
# ==============================================================================
set -euo pipefail

CGATE_MODE=$(bashio::config 'cgate_mode' 'remote')

if [[ "${CGATE_MODE}" != "managed" ]]; then
    bashio::log.info "C-Gate mode is '${CGATE_MODE}', C-Gate service sleeping"
    exec sleep infinity
fi

# Overridable so the unit tests can run this script against a temp dir instead
# of the real /data/cgate, the same seam cgate-install.sh uses. Unset in
# production, so it always resolves to /data/cgate there.
CGATE_DIR="${CGATE_DIR:-/data/cgate}"
CGATE_JAR="${CGATE_DIR}/cgate.jar"

if [[ ! -f "${CGATE_JAR}" ]]; then
    bashio::log.error "C-Gate not installed. Check cont-init.d logs."
    sleep 30
    exit 1
fi

CGATE_PORT=$(bashio::config 'cgate_port' '20023')
CGATE_EVENT_PORT=$(bashio::config 'cgate_event_port' '20025')

bashio::log.info "Starting C-Gate server..."
bashio::log.info "  Command port: ${CGATE_PORT}"
bashio::log.info "  Event port: ${CGATE_EVENT_PORT}"

cd "${CGATE_DIR}" || exit 1

# No -s / --servermode. Its only server-side effect is a "Shutdown is not
# recommended" warning before C-Gate shuts down anyway, but it also makes
# C-Gate answer `get cgate ServerMode` with yes — and C-Bus Toolkit reads that
# to decide where the unit catalogue comes from. With ServerMode=yes Toolkit
# loads the catalogue locally instead of fetching it from this C-Gate, fails,
# and shows "No Catalog Available" with no networks, even though C-Gate has the
# project fully synced (#122). C-Gate stays up without it: s6 runs it with
# stdin closed and the console reaching EOF does not stop the server.
exec java \
    -Djava.awt.headless=true \
    -Djava.net.preferIPv4Stack=true \
    -XX:+UseSerialGC \
    -XX:TieredStopAtLevel=1 \
    -Xmx256m \
    -Xms64m \
    -jar "${CGATE_JAR}"
